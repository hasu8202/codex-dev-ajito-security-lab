{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pwsh -NoProfile -File scripts/codex-verify.ps1)",
      "PowerShell(pwsh -NoProfile -File scripts/codex-verify.ps1)",
      "PowerShell(./scripts/codex-verify.ps1)",
      "Bash(git status)",
      "PowerShell(git status)",
      "Bash(git status *)",
      "PowerShell(git status *)",
      "Bash(git diff)",
      "PowerShell(git diff)",
      "Bash(git diff *)",
      "PowerShell(git diff *)",
      "Bash(git log)",
      "PowerShell(git log)",
      "Bash(git log *)",
      "PowerShell(git log *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/service-account*.json)",
      "Read(**/.credentials/**)",
      "Read(~/.ssh/**)",
      "Read(~/.codex/auth.json)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "PowerShell(rm -rf *)",
      "PowerShell(Remove-Item *-Recurse*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git reset --hard*)"
    ]
  }
}
